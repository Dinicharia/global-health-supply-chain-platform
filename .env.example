# =============================================================================
# Global Health Supply Chain Intelligence Platform — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit real credentials.

# --- PostgreSQL: main application connection (used by ETL, has write access) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5435
POSTGRES_DB=supply_chain_platform
POSTGRES_USER=etl_user
POSTGRES_PASSWORD=changeme

# --- PostgreSQL: read-only role for BI tools (Superset, Power BI) ---
# Separate credential set — see Security Strategy (Phase 2): least-privilege,
# BI tools connect through a role that cannot write, only SELECT.
POSTGRES_READONLY_USER=bi_reader
POSTGRES_READONLY_PASSWORD=changeme

# --- Prefect ---
PREFECT_API_URL=http://localhost:4200/api
# PREFECT_HOME: isolates this project's Prefect state (flow run history,
# local database) into its own folder, rather than sharing the default
# machine-wide ~/.prefect location. This avoids collisions with other
# Prefect-based projects on the same machine that may be running a
# different Prefect version with an incompatible internal database schema.
PREFECT_HOME=.prefect

# --- External APIs ---
# Leave blank and the extraction layer will fall back to simulated data
# (see Phase 2 Data Sources decision: simulate when no reliable free API exists)
WEATHER_API_KEY=
EXCHANGE_RATE_API_KEY=

# --- Pipeline behavior ---
# Environment name affects logging verbosity and debug port exposure
ENVIRONMENT=local

# --- Apache Superset (needed here too, for docker-compose.yml's own
# ${...} variable substitution -- separate mechanism from .env.docker,
# which only injects vars INTO the running container itself) ---
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=changeme
SUPERSET_SECRET_KEY=changeme-generate-a-real-secret-key-before-any-real-deployment
SUPERSET_DATABASE_URI=postgresql+psycopg2://etl_user:changeme@postgres:5432/superset