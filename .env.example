# =============================================================================
# Global Health Supply Chain Intelligence Platform — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit real credentials.

# --- PostgreSQL: main application connection (used by ETL, has write access) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5435
POSTGRES_DB=supply_chain_platform
POSTGRES_USER=etl_user
POSTGRES_PASSWORD=changeme

# --- PostgreSQL: read-only role for BI tools (Superset, Power BI) ---
# Separate credential set — see Security Strategy (Phase 2): least-privilege,
# BI tools connect through a role that cannot write, only SELECT.
POSTGRES_READONLY_USER=bi_reader
POSTGRES_READONLY_PASSWORD=changeme

# --- Prefect ---
PREFECT_API_URL=http://localhost:4200/api

# --- External APIs ---
# Leave blank and the extraction layer will fall back to simulated data
# (see Phase 2 Data Sources decision: simulate when no reliable free API exists)
WEATHER_API_KEY=
EXCHANGE_RATE_API_KEY=

# --- Pipeline behavior ---
# Environment name affects logging verbosity and debug port exposure
ENVIRONMENT=local
