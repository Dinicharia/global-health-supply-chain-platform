# Environment & secrets — NEVER commit real credentials
.env
.env.docker

# Python
__pycache__/
*.pyc
.venv/
venv/

# pyenv-generated version marker for THIS repo — actually, we DO want to track this
# (see note below — .python-version is intentionally NOT listed here)

# Local data files — these are runtime output, not source code, and can be large
data/bronze/*
data/silver/*
data/gold/*
!data/bronze/.gitkeep
!data/silver/.gitkeep
!data/gold/.gitkeep
data/raw/*
!data/raw/.gitkeep

# Logs — runtime output, regenerated every run, not meaningful to version
logs/pipeline/*
logs/api/*
logs/transformation/*
logs/error/*
!logs/pipeline/.gitkeep
!logs/api/.gitkeep
!logs/transformation/.gitkeep
!logs/error/.gitkeep

# Backups — large binary dumps, don't belong in git history
backups/*
!backups/.gitkeep

# VS Code local settings (keep shared settings, ignore personal ones)
.vscode/*
!.vscode/settings.json

# OS-generated files
.DS_Store
Thumbs.db

# Virtual environment
.venv/

# Prefect local state (project-isolated, see .env PREFECT_HOME)
.prefect/

# Power BI report file -- Import mode embeds a full snapshot of query
# results directly in the .pbix binary, making this file a generated
# data artifact (like data/raw/ or logs/), not source code. The real
# "source" is the DAX measures and gold.* views, both already
# documented/version-controlled in sql/schemas/10_gold_views.sql and
# this conversation's record. Re-creating the report from those plus
# the report structure documented in docs/ (Phase 13) is the intended
# recovery path, not tracking the binary itself.
*.pbix