# =============================================================================
# Docker Compose environment overrides
# =============================================================================
# This file is used ONLY by docker-compose.yml -- NOT loaded by local
# python -m ... commands, which continue to use .env as before.
#
# Key difference from .env: POSTGRES_HOST and PREFECT_API_URL both
# reference Docker service names (postgres, prefect-server) instead of
# localhost -- inside Compose's internal network, containers reach each
# other by service name via Docker's built-in DNS, never localhost
# (localhost inside a container means THAT container itself, not a
# sibling container -- see Phase 4 conversation history for the exact
# reasoning behind this distinction).

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=supply_chain_platform
POSTGRES_USER=etl_user
POSTGRES_PASSWORD=changeme

POSTGRES_READONLY_USER=bi_reader
POSTGRES_READONLY_PASSWORD=changeme

PREFECT_API_URL=http://prefect-server:4200/api

WEATHER_API_KEY=
EXCHANGE_RATE_API_KEY=

ENVIRONMENT=docker

# --- Apache Superset ---
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=changeme
SUPERSET_SECRET_KEY=changeme-generate-a-real-secret-key-before-any-real-deployment
SUPERSET_DATABASE_URI=postgresql+psycopg2://etl_user:changeme@postgres:5432/superset